<!--
  音乐亭小面板：立在音乐亭前来客一侧。文案（本阶段定版）：
  「歌从这里起，脚步随意。」——音乐亭主「听与舞」，语气与长椅、
  蛇园面板同调：只邀请，不催促起舞。纯展示面板，无按钮；排版
  沿用 bench 面板的量级。
-->
<style>
  @font-face { font-family: "noto-sans-sc"; src: url("../fonts/noto-sans-sc-regular.ttf"); font-weight: normal; }
  @font-face { font-family: "noto-sans-sc"; src: url("../fonts/noto-sans-sc-bold.ttf"); font-weight: bold; }

  .music-root {
    flex-direction: column;
    width: 520px;
  }

  .music-content {
    flex-direction: column;
    align-items: center;
    gap: 9px;
    padding-top: 22px;
    padding-bottom: 22px;
    padding-left: 26px;
    padding-right: 26px;
  }

  .music-line {
    font-family: noto-sans-sc;
    color: #1c1d20;
    font-size: 30px;
    font-weight: 700;
    line-height: 40px;
    text-align: center;
  }

  .music-line:dark {
    color: #fafaf7;
  }

  .music-sub {
    color: #3a3b40;
    font-size: 16px;
    line-height: 22px;
    letter-spacing: 0.6px;
    text-align: center;
  }

  .music-sub:dark {
    color: #c9c4b4;
  }

  .music-fallback {
    font-family: noto-sans-sc;
    color: #6a675c;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.3px;
    text-align: center;
  }

  .music-fallback:dark {
    color: #9d988a;
  }
</style>
<Panel class="music-root">
  <div class="music-content">
    <div class="music-line">歌从这里起，脚步随意</div>
    <div class="music-sub">The song begins here. Dance if you like.</div>
    <div class="music-fallback">手势识别不到时，捏合并保持 2 秒推进 · If a gesture is missed, pinch and hold for 2 seconds.</div>
  </div>
</Panel>
