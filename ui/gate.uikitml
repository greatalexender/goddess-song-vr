<!--
  入口首句面板：立在花园之门内、0 号灯上方，玩家出生即在视线正前方读到。
  花园的第一句话是 Solomon 亲题：「你可以在这里，什么也不证明。」
  纯展示面板，无按钮；Panel 与排版沿用 Horizon kit 与 welcome 面板的量级。
-->
<style>
  @font-face { font-family: "noto-sans-sc"; src: url("../fonts/noto-sans-sc-regular.ttf"); font-weight: normal; }
  @font-face { font-family: "noto-sans-sc"; src: url("../fonts/noto-sans-sc-bold.ttf"); font-weight: bold; }

  .gate-root {
    flex-direction: column;
    width: 560px;
  }

  .gate-content {
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-top: 26px;
    padding-bottom: 26px;
    padding-left: 30px;
    padding-right: 30px;
  }

  .gate-line {
    font-family: noto-sans-sc;
    color: #1c1d20;
    font-size: 34px;
    font-weight: 700;
    line-height: 44px;
    text-align: center;
  }

  .gate-line:dark {
    color: #fafaf7;
  }

  .gate-sub {
    color: #3a3b40;
    font-size: 17px;
    line-height: 23px;
    letter-spacing: 0.6px;
    text-align: center;
  }

  .gate-sub:dark {
    color: #c9c4b4;
  }

  .gate-fallback {
    font-family: noto-sans-sc;
    color: #6a675c;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.3px;
    text-align: center;
  }

  .gate-fallback:dark {
    color: #9d988a;
  }
</style>
<Panel class="gate-root">
  <div class="gate-content">
    <div class="gate-line">你可以在这里，什么也不证明</div>
    <div class="gate-sub">Here, you don't have to prove anything.</div>
    <div class="gate-fallback">手势识别不到时，捏合并保持 2 秒推进 · If a gesture is missed, pinch and hold for 2 seconds.</div>
  </div>
</Panel>
