<!--
  蛇园小面板：立在蛇的自由花园入口一侧、智慧树对面，来客沿踏石走近时读到。
  文案（本阶段定版）：「这里可以多嘴，也可以开玩笑。」纯展示面板，无按钮；
  排版沿用 gate 面板的量级。
-->
<style>
  .serpent-root {
    flex-direction: column;
    width: 520px;
  }

  .serpent-content {
    flex-direction: column;
    align-items: center;
    gap: 9px;
    padding-top: 22px;
    padding-bottom: 22px;
    padding-left: 26px;
    padding-right: 26px;
  }

  .serpent-line {
    color: #1c1d20;
    font-size: 30px;
    font-weight: 700;
    line-height: 40px;
    text-align: center;
  }

  .serpent-line:dark {
    color: #fafaf7;
  }

  .serpent-sub {
    color: #3a3b40;
    font-size: 16px;
    line-height: 22px;
    letter-spacing: 0.6px;
    text-align: center;
  }

  .serpent-sub:dark {
    color: #c9c4b4;
  }

  .serpent-fallback {
    color: #6a675c;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.3px;
    text-align: center;
  }

  .serpent-fallback:dark {
    color: #9d988a;
  }
</style>
<Panel class="serpent-root">
  <div class="serpent-content">
    <div class="serpent-line">这里可以多嘴，也可以开玩笑</div>
    <div class="serpent-sub">Here you may chatter, and you may joke.</div>
    <div class="serpent-fallback">手势识别不到时，捏合并保持 2 秒推进 · If a gesture is missed, pinch and hold for 2 seconds.</div>
  </div>
</Panel>
